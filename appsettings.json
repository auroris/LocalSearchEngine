{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "db": "../search.db",
  "SearchSettings": {
    "CandidatePoolSize": 500,
    "MaxDistance": 0.6,
    "ReciprocalRankConstant": 60,
    "SemanticWeight": 1.0,
    "KeywordWeight": 1.0,
    "InboundLinkWeight": 0.75,
    "InboundContextBoost": 0.2,
    "InboundSourceAuthorityWeight": 0.25,
    "AuthorityWeight": 0.2,
    "ExactPhraseBoost": 0.35,
    "ProximityBoost": 0.15,
    "HeadingBoost": 0.3,
    "TitleBoost": 0.35,
    "FilenameBoost": 0.4,
    "TermInTextBoost": 0.2,
    "MultiChunkBoost": 0.1,
    "NonHtmlPenalty": 0.15
  },
  "CrawlSettings": {
    "max-pages": null,
    "max-pages-per-host": null,
    "max-crawl-size-bytes": 15728640,
    "request-delay-ms": 100,
    "request-timeout-seconds": 100,
    "connect-timeout-seconds": 15,
    "allowed-servers": [ "http://coldlake.mil.ca", "http://documents.coldlake.mil.ca" ],
    "allow-incremental": true,
    "incremental-feed": "http://coldlake.mil.ca/rss.xml",
    "noindex-patterns": [ "http://coldlake.mil.ca/en/Documents/*", "http://coldlake.mil.ca/fr/Documents/*" ],
    "check-external-links": false,
    "no-live-stats": false
  }
}
