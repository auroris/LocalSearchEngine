<Project>

  <!--
    Local embedding model for SmartComponents.LocalEmbeddings, shared by every project so
    they all agree (the web app references the package directly, so it runs the model
    targets too). The model + vocab are downloaded once at build time (cached in the NuGet
    package folder) and copied into each project's output as LocalEmbeddingsModel\<name>\.

    The <name> below MUST match LocalEmbedderAdapter.ModelName in code.

    snowflake-arctic-embed-s: 384-dimensional, BERT/WordPiece, int8-quantized ONNX (~32 MB),
    Apache-2.0 licensed.
    To change models: update all three properties (and the dimension on
    TextChunkRecord.Embedding if it differs from 384), then re-index.
  -->
  <PropertyGroup>
    <LocalEmbeddingsModelName>snowflake-arctic-embed-s</LocalEmbeddingsModelName>
    <LocalEmbeddingsModelPath>$(MSBuildThisFileDirectory)LocalEmbeddingsModel\snowflake-arctic-embed-s\model.onnx</LocalEmbeddingsModelPath>
    <LocalEmbeddingsVocabPath>$(MSBuildThisFileDirectory)LocalEmbeddingsModel\snowflake-arctic-embed-s\vocab.txt</LocalEmbeddingsVocabPath>
  </PropertyGroup>

  <!--
    Suppress NU1903 for GHSA-2m69-gcr7-jv3q: a memory-corruption bug in SQLite < 3.50.2 (a query
    with more aggregate terms than columns), reached through the transitive native package
    SQLitePCLRaw.lib.e_sqlite3 — which is deprecated and has no fixed version to upgrade to. It is
    not reachable here: every SQL statement the app runs is fixed-shape and parameterized, and
    crawled HTML/PDF/DOCX is stored as bound data, never executed as SQL, so no input can craft the
    offending aggregate query. Drop this once a maintained e_sqlite3 bundle ships an unaffected build.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
